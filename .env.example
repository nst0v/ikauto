# Необязательная замена встроенного PHP-обработчика /api/lead.php.
VITE_FORM_ENDPOINT=/api/lead.php

# MAX настраивается на PHP-сервере командой php scripts/max-bot.php init.
# Vite .env не передаётся PHP. Токен нельзя помещать в переменные VITE_*.
# Серверные переменные (задайте в окружении PHP, а не в этой .env):
# MAX_CONFIG_FILE=/home/account/ikauto/ikauto-private/max.php
# MAX_BOT_TOKEN=<токен бота>
# MAX_WEBHOOK_SECRET=<случайный секрет webhook>
# MAX_CONNECT_CODE=<случайный код привязки>
# MAX_STATE_DIR=/home/account/ikauto/ikauto-private/max-state
# MAX_CHAT_ID=<необязательный ID группового чата>
# MAX_CA_BUNDLE=/absolute/path/to/trusted-ca-bundle.pem
